# Copy to .env (gitignored). Restart Expo after changes.

# basic (default in code) | oidc_implicit | oidc_code | demo
# Use demo to reach Today without Sync Gateway.
EXPO_PUBLIC_AUTH_STRATEGY=demo

# Sync Gateway / App Services (required for basic once wired)
EXPO_PUBLIC_SG_URL=
EXPO_PUBLIC_SG_DB=mfs

# Tracking crumbs: meters of movement before a point is stored (152 ≈ 500 ft)
EXPO_PUBLIC_TRACK_MIN_MOVE_M=100
