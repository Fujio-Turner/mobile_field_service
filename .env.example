# Copy to .env (gitignored). Restart Expo after changes.
# Catalog of every setting: guides/SETTINGS.md

# basic (default in code) | oidc_implicit | oidc_code | demo
# Use demo to reach Today without Sync Gateway.
EXPO_PUBLIC_AUTH_STRATEGY=demo

# Sync Gateway / App Services (required for basic)
EXPO_PUBLIC_SG_URL=
EXPO_PUBLIC_SG_DB=mfs
# Optional pull-channel filter applied to every field collection when nothing is saved
# on Profile → Settings / debug. Empty (default) = all channels the session can access.
# EXPO_PUBLIC_SG_CHANNELS=
# Lab only: allow self-signed certs (also implied by ws://)
# EXPO_PUBLIC_SG_SELF_SIGNED=true
EXPO_PUBLIC_SESSION_REFRESH_SKEW_SEC=300

# Replication schema (build-time, not a Profile toggle). Restart Expo after change.
# simple  = one continuous replicator for all field.* except tmp (default)
# oneshot = one-shot workordersin+orders first, then one-shot all field.* every N seconds
#           and when the app comes to the foreground
EXPO_PUBLIC_REPL_SCHEMA=simple
# Follow-up oneshot interval (seconds). Default 300 = 5 minutes. Minimum 30.
EXPO_PUBLIC_REPL_ONESHOT_SEC=300

# Tracking crumbs: meters of movement before a point is stored (152 ≈ 500 ft)
EXPO_PUBLIC_TRACK_MIN_MOVE_M=100

# Optional MapLibre style URL. Default is OpenFreeMap Liberty (needs network).
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Opt-in CBL query.explain() (noisy). Do not ship with this on.
# EXPO_PUBLIC_QUERY_EXPLAIN=1
